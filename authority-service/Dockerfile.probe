FROM python:3.11.17-slim-trixie@sha256:cce12316475d7d56d605f76e1d811d0dc4e7227f2d4afd29951521264f504ff8

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/opt/pulpo/authority-service/src

RUN groupadd --system pulpo \
    && useradd --system --gid pulpo --home-dir /nonexistent --shell /usr/sbin/nologin pulpo \
    && mkdir -p /opt/pulpo/authority-service/src/pulpo_authority_service

WORKDIR /opt/pulpo

COPY authority-service/src/pulpo_authority_service/cloud_sql_state.py ./authority-service/src/pulpo_authority_service/cloud_sql_state.py
COPY authority-service/src/pulpo_authority_service/cloud_sql_probe.py ./authority-service/src/pulpo_authority_service/cloud_sql_probe.py

RUN python -m pip install --no-cache-dir --upgrade 'pip==26.2.2' 'setuptools==84.2.1' 'wheel==0.48.0' \
    && python -m pip install --no-cache-dir \
      'cloud-sql-python-connector==1.22.0' \
      'pg8000==1.31.5' \
    && python -m pip check \
    && chown -R pulpo:pulpo /opt/pulpo

USER pulpo

CMD ["python", "-m", "pulpo_authority_service.cloud_sql_probe"]
