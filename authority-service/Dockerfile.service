FROM python:3.11.17-slim-trixie@sha256:cce12316475d7d56d605f76e1d811d0dc4e7227f2d4afd29951521264f504ff8

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN groupadd --system pulpo \
    && useradd --system --gid pulpo --home-dir /nonexistent --shell /usr/sbin/nologin pulpo \
    && mkdir -p /opt/pulpo/authority-service

WORKDIR /opt/pulpo

COPY authority-service ./authority-service

RUN python -m pip install --no-cache-dir --upgrade 'pip==26.2.2' 'setuptools==84.2.1' 'wheel==0.48.0' \
    && python -m pip install --no-cache-dir \
      './authority-service[gcp-auth,gcp-kms,gcp-storage,gcp-cloud-sql]' \
    && python -m pip check \
    && chown -R pulpo:pulpo /opt/pulpo

# Service images do not need terminal inspection tools or SUID/SGID helpers.
RUN find / -xdev -type f -perm /6000 -exec chmod a-s -- {} + \
    && rm -f -- /usr/bin/infocmp
USER pulpo

EXPOSE 8080

CMD ["python", "-m", "uvicorn", "pulpo_authority_service.production_runtime:create_production_app_from_env", "--factory", "--host", "0.0.0.0", "--port", "8080"]
